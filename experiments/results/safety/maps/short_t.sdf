<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <world name="line_track">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <dart>
        <collision_detector>bullet</collision_detector>
      </dart>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
    </light>
    <model name="room_floor">
      <static>true</static>
      <pose>1.65 1.65 -0.104 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>20 20 0.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>20 20 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.63 0.68 1</ambient>
            <diffuse>0.6 0.63 0.68 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <include>
      <uri>model://turtlebot3_waffle_pi</uri>
      <name>turtlebot3_waffle_pi</name>
      <pose>0.5 0.5 0.01 0 0 0</pose>
    </include>
    <model name="track">
      <static>true</static>
      <link name="surface">
        <collision name="mat_collision">
          <pose>1.8 1.25 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>3.6 2.5 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="mat_visual">
          <pose>1.8 1.25 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>3.6 2.5 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.82 0.72 0.55 1</ambient>
            <diffuse>0.82 0.72 0.55 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
      <link name="line">
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <mesh>
              <uri>./short_t.stl</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0 0 0 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>